# ── Bot Mode ──────────────────────────────────────────────────
BOT_MODE=demo              # demo | live
LIVE_TRADING_ENABLED=false # must be true for real orders
DRY_RUN=true               # must be false for real orders

# ── Polymarket Credentials (live mode only) ────────────────────
POLY_PRIVATE_KEY=0x...
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_FUNDER_ADDRESS=

# ── API Endpoints ──────────────────────────────────────────────
CLOB_URL=https://clob.polymarket.com
GAMMA_URL=https://gamma-api.polymarket.com
CHAIN_ID=137

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./polymaus.db
# For production: postgresql+asyncpg://user:pass@localhost/polymaus

# ── Risk Controls ──────────────────────────────────────────────
MAX_POSITION_USD=50.0       # Max USD per position
MAX_DAILY_LOSS_USD=200.0    # Daily loss limit
MAX_OPEN_POSITIONS=20       # Max concurrent positions
PORTFOLIO_ALLOC_PCT=0.02    # 2% per trade
MIN_TRADE_USD=5.0           # Minimum trade size
MAX_ENTRY_PRICE=0.65        # Never enter above this probability

# ── Strategy Parameters ────────────────────────────────────────
DEFAULT_STRATEGY=contrarian  # contrarian | market_maker | signal | adaptive
MARKET_REFRESH_SECS=600      # How often to scan new markets
PRICE_POLL_SECS=30           # Price update frequency
MM_SPREAD_BPS=200            # Market-maker target spread in bps
SIGNAL_CONSENSUS_REQUIRED=2  # Signals that must agree before trading

# ── Demo Mode ──────────────────────────────────────────────────
DEMO_STARTING_BALANCE=10000.0
DEMO_SLIPPAGE_BPS=10         # Simulated slippage

# ── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
